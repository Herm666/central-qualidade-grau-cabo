# Copie para .env.local e informe a URL do PostgreSQL do Neon.\nDATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"\n

$url = (Get-Clipboard -Raw).Trim()

foreach ($arquivo in @(".\.env", ".\.env.local")) {
    $linhas = if (Test-Path $arquivo) { @(Get-Content $arquivo) } else { @() }
    $linhas = @($linhas | Where-Object { $_ -notmatch '^\s*DATABASE_URL\s*=' })
    $linhas += "DATABASE_URL=`"$url`""
    Set-Content -Path $arquivo -Value $linhas -Encoding utf8
}

Remove-Variable url

npx prisma validate"
DATABASE_URL="postgresql://neondb_owner:npg_m0kLQi1HxgwT@ep-soft-silence-acvct6xq-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
